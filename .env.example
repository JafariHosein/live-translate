# Live Translate configuration
# Copy this file to .env (project directory) or ~/.config/live-translate/.env
# and adjust the values you need.  Real environment variables take priority.
#
#   cp .env.example .env
#   chmod 600 .env

# ------------------------------------------------------------------------------
# Provider
# ------------------------------------------------------------------------------
# free = Google Web Speech STT + Google Translate (no API key, works out of the box)
# groq = Whisper large-v3-turbo STT + Llama 3.3 70B translation (requires a key)
LIVE_TRANSLATE_PROVIDER=free

# ------------------------------------------------------------------------------
# Groq (only used when LIVE_TRANSLATE_PROVIDER=groq)
# ------------------------------------------------------------------------------
# Free keys: https://console.groq.com/keys
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GROQ_TRANSLATION_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Push-to-talk (evdev key name or numeric key code)
# ------------------------------------------------------------------------------
# Examples: KEY_RIGHTALT, KEY_F8, KEY_PAUSE, KEY_RIGHTCTRL
LIVE_TRANSLATE_PTT_KEY=KEY_RIGHTALT
# How often to rescan /dev/input for newly connected keyboards (seconds)
# LIVE_TRANSLATE_RESCAN_SECONDS=5.0

# ------------------------------------------------------------------------------
# Audio
# ------------------------------------------------------------------------------
# LIVE_TRANSLATE_SAMPLE_RATE=16000
# LIVE_TRANSLATE_CHANNELS=1
# LIVE_TRANSLATE_MIN_SECONDS=0.3
# sounddevice latency hint: high, low, or 0 (default device setting)
# LIVE_TRANSLATE_INPUT_LATENCY=high

# ------------------------------------------------------------------------------
# Network timeouts (seconds)
# ------------------------------------------------------------------------------
# LIVE_TRANSLATE_STT_TIMEOUT=30.0
# LIVE_TRANSLATE_TRANSLATE_TIMEOUT=20.0

# ------------------------------------------------------------------------------
# Window and history
# ------------------------------------------------------------------------------
# LIVE_TRANSLATE_OPACITY=0.95
# LIVE_TRANSLATE_WIDTH=520
# LIVE_TRANSLATE_HEIGHT=680
# LIVE_TRANSLATE_HISTORY_LIMIT=40

# ------------------------------------------------------------------------------
# Languages
# ------------------------------------------------------------------------------
# BCP-47 / Google language codes
# LIVE_TRANSLATE_SOURCE_LANGUAGE=en-US
# LIVE_TRANSLATE_TARGET_LANGUAGE=fa

# ------------------------------------------------------------------------------
# Logging: DEBUG, INFO, WARNING, ERROR
# ------------------------------------------------------------------------------
# LIVE_TRANSLATE_LOG_LEVEL=INFO
